@@ file: data/maps/Route110/scripts.inc
Route110_Text_MayLetsBattle:
Route110_Text_BrendanLetsBattle:
	.string "HAMZA: {PLAYER}! Long time no see!\p"
	.string "I found a new gimmick. The best one.\n"
	.string "You'll see. Battle first!$"

Route110_Text_MayTakeThis:
Route110_Text_BrendanTakeThis:
	.string "HAMZA: You've been training too,\n"
	.string "haven't you?\p"
	.string "Okay. You deserve these.\n"
	.string "They're from me. Not HISHAM.$"

Route110_Text_MayExplainItemfinder:
Route110_Text_BrendanExplainItemfinder:
	.string "HAMZA: The DOWSING MACHINE beeps\n"
	.string "when there's a hidden item.\p"
	.string "But the RING is the good part!\p"
	.string "Once your POKéMON learns its own\n"
	.string "special move, and holds its CRYSTAL…\p"
	.string "It can turn that move into a G-MOVE,\n"
	.string "once per battle! Best gimmick ever!\p"
	.string "HISHAM says G-MOVES are cheating.\n"
	.string "HISHAM can't even use one.\p"
	.string "I'm not taking my sneakers off!\n"
	.string "I am SNEAKERS O'TOOLE!$"

Route110_Text_KeepAnEyeOutForRival:
	.string "PROF. MO: {PLAYER}…\p"
	.string "Please keep an eye out for HAMZA.\n"
	.string "He ran off in his sneakers again.\p"
	.string "Well, I had better get going.\n"
	.string "HISHAM's buying the crazy fries!$"

@@ file: data/maps/Route119/scripts.inc
Route119_Text_MayIntro:
Route119_Text_BrendanIntro:
	.string "HAMZA: {PLAYER}!\n"
	.string "There you are!\p"
	.string "My partner holds a G-CRYSTAL now,\n"
	.string "same as yours. Let me show you!\p"
	.string "Ready? Of course you are! Go!$"

Route119_Text_MayDefeat:
Route119_Text_BrendanDefeat:
	.string "Ahh! {PLAYER}, you're strong!\p"
	.string "Even against a G-MOVE…$"

Route119_Text_MayPresentForYou:
Route119_Text_BrendanIllGiveYouThis:
	.string "HAMZA: Okay, okay.\n"
	.string "I have a present for you.$"

Route119_Text_MayExplainFly:
Route119_Text_BrendanExplainFly:
	.string "HAMZA: With FLY, your POKéMON can\n"
	.string "carry you to any town you've seen.\p"
	.string "You need FORTREE CITY's GYM BADGE\n"
	.string "to use it, though.\p"
	.string "Go see your mom in LITTLEROOT.\n"
	.string "And tell HISHAM to stop texting me.\p"
	.string "I'm not taking my sneakers off!\n"
	.string "I am SNEAKERS O'TOOLE!$"

@@ file: data/maps/LilycoveCity/scripts.inc
LilycoveCity_Text_MayShoppingLetsBattle:
LilycoveCity_Text_BrendanShoppingLetsBattle:
	.string "HAMZA: {PLAYER}! Are you shopping,\n"
	.string "too?\p"
	.string "I'm looking for a MEGA STONE.\n"
	.string "They don't have any. Again.\p"
	.string "HISHAM offered to buy me one with\n"
	.string "his SEQUOIA money. I said no!\p"
	.string "…Okay, I said maybe.\p"
	.string "Battle me! I want to see how your\n"
	.string "POKéMON are doing.$"

LilycoveCity_Text_MayNotRaisingPokemon:
LilycoveCity_Text_BrendanNoConfidence:
	.string "HAMZA: Not ready?\n"
	.string "Come back when you are.$"

LilycoveCity_Text_MayBattleMe:
LilycoveCity_Text_BrendanBattleMe:
	.string "HAMZA: Come on, battle me!\n"
	.string "I want to see your POKéMON!$"

LilycoveCity_Text_MayWontBeBeaten:
LilycoveCity_Text_BrendanWontBeBeaten:
	.string "HAMZA: My G-MOVE won't lose\n"
	.string "to you, {PLAYER}!$"

LilycoveCity_Text_MayDefeat:
LilycoveCity_Text_BrendanDefeat:
	.string "… … … … … … … …\p"
	.string "I remember our battle on ROUTE 103.\n"
	.string "You had no gimmicks then, either.\p"
	.string "Maybe you don't need them.\n"
	.string "Don't tell HISHAM I said that.$"

LilycoveCity_Text_MayGoingBackToLittleroot:
LilycoveCity_Text_BrendanGoingBackToLittleroot:
	.string "HAMZA: I'm going back to\n"
	.string "LITTLEROOT soon.\p"
	.string "HISHAM is having PROF. MO over to\n"
	.string "play pool. He invited me, too.\p"
	.string "Not LAYTH. His actual son.\n"
	.string "Just me. Again.$"

LilycoveCity_Text_MayYouGoingToCollectBadges:
LilycoveCity_Text_BrendanYouGoingToCollectBadges:
	.string "{PLAYER}, what are you going to do?\p"
	.string "Collect all the GYM BADGES and take\n"
	.string "the POKéMON LEAGUE challenge?\p"
	.string "I'm going to find every gimmick in\n"
	.string "HOENN. I'll find them before you!\p"
	.string "I'm not taking my sneakers off!\n"
	.string "I am SNEAKERS O'TOOLE!$"

LilycoveCity_Text_MayYouGoingToPokemonLeague:
LilycoveCity_Text_BrendanYouGoingToPokemonLeague:
	.string "{PLAYER}, what are you going to do?\p"
	.string "Are you taking the POKéMON LEAGUE\n"
	.string "challenge?\p"
	.string "I lost to you in battle, but I'll\n"
	.string "find every gimmick before you!\p"
	.string "I'm not taking my sneakers off!\n"
	.string "I am SNEAKERS O'TOOLE!$"

LilycoveCity_Text_MayYouGoingToBattleFrontier:
LilycoveCity_Text_BrendanYouGoingToBattleFrontier:
	.string "{PLAYER}, what are you going to do?\p"
	.string "Are you taking the BATTLE FRONTIER\n"
	.string "challenge?\p"
	.string "I lost to you in battle, but I'll\n"
	.string "find every gimmick before you!\p"
	.string "I'm not taking my sneakers off!\n"
	.string "I am SNEAKERS O'TOOLE!$"

