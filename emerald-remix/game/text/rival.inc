@@ file: data/maps/RustboroCity/scripts.inc
RustboroCity_Text_MayHiLetsRegister:
RustboroCity_Text_BrendanHiLetsRegister:
	.string "HAMZA: Oh, hi, {PLAYER}!\p"
	.string "Your POKéNAV has MATCH CALL now!\n"
	.string "That's a pretty good gimmick.\p"
	.string "Let's register each other!\p"
	.string "… … … … … …$"

RustboroCity_Text_MayPassedBrineyWantToBattle:
RustboroCity_Text_BrendanPassedBrineyWantToBattle:
	.string "HAMZA: I passed MR. BRINEY in\n"
	.string "PETALBURG WOODS.\p"
	.string "HISHAM was pitching him SEQUOIA.\n"
	.string "Investing, or whatever.\p"
	.string "Then he told MR. BRINEY I'm like a\n"
	.string "son to him. I'm not his son!\p"
	.string "Anyway…\n"
	.string "How about a little battle?$"

RustboroCity_Text_MayOhHaventRaisedPokemonEnough:
RustboroCity_Text_BrendanNoConfidenceInPokemon:
