@@ file: data/maps/FallarborTown/scripts.inc
FallarborTown_Text_HaveYouChallengedFlannery:
	.string "Have you already challenged NABIL,\n"
	.string "the LEADER of LAVARIDGE GYM?\p"
	.string "The boy's grandfather was famous.\n"
	.string "He was one of the ELITE FOUR in the\l"
	.string "POKéMON LEAGUE at one point.\p"
	.string "It wouldn't surprise me to see NABIL\n"
	.string "become a great TRAINER in his own\l"
	.string "right.$"

@@ file: data/maps/LavaridgeTown_Gym_1F/scripts.inc
LavaridgeTown_Gym_1F_Text_GymGuideAdvice:
	.string "Hey, how's it going, CHAMPION-\n"
	.string "bound {PLAYER}?\p"
	.string "LAVARIDGE's GYM LEADER NABIL\n"
	.string "uses FIRE-type POKéMON.\p"
	.string "His passion for POKéMON burns\n"
	.string "stronger and hotter than a volcano.\p"
	.string "Don't get too close to him--you'll\n"
	.string "burn! Hose him down with water and\l"
	.string "then go for it!$"

@@ file: data/maps/FortreeCity_Gym/scripts.inc
FortreeCity_Gym_Text_FlintPostBattle:
	.string "ADAM JABER is cool, and he's strong.\n"
	.string "He's the ultimate LEADER!$"

FortreeCity_Gym_Text_HumbertoIntro:
	.string "When ADAM JABER battles, his\n"
	.string "face shines with determination…\p"
	.string "I'm not letting you see that!$"

FortreeCity_Gym_Text_HumbertoPostBattle:
	.string "You'd better watch it!\n"
	.string "Don't get distracted by ADAM JABER\l"
	.string "or you'll go crashing down in a heap!$"

@@ file: data/maps/MossdeepCity_Gym/scripts.inc
MossdeepCity_Gym_Text_TateAndLizaIntro:
	.string "HAFIZ: Hehehe… Were you surprised?\p"
	.string "ABDU: Fufufu… Were you surprised?\p"
	.string "HAFIZ: That there are two GYM\n"
	.string "LEADERS?\l"
	.string "ABDU: That there are two GYM\n"
	.string "LEADERS?\p"
	.string "HAFIZ: We're OMAR HAFIZ…\n"
	.string "ABDU: …and MO ABDU!\p"
	.string "HAFIZ: We don't need to talk because…\n"
	.string "ABDU: We can each tell what…\p"
	.string "HAFIZ: The other is thinking…\n"
	.string "ABDU: All in our minds!\p"
	.string "HAFIZ: This combination of ours…\n"
	.string "ABDU: Can you beat it?$"

MossdeepCity_Gym_Text_TateAndLizaPostBattle:
	.string "HAFIZ: Looks like the bond between\n"
	.string "you and your POKéMON is far stronger\l"
	.string "than the bond between us two.\p"
	.string "ABDU: You will become even stronger!\n"
	.string "We've battled you, so we know.$"
