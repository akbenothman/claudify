@@ file: data/maps/RusturfTunnel/scripts.inc
RusturfTunnel_Text_ThankYouLetsGoHomePeeko:
	.string "PEEKO owes her life to you!\p"
	.string "They call me IZZO.\n"
	.string "And, you are?\p"
	.string "… … … … … … … …\n"
	.string "… … … … … … … …\p"
	.string "HISHAM's kid! Of course!\p"
	.string "You ever watch TOP G? Discipline.\n"
	.string "Pushups. Kickboxing. Every day.\p"
	.string "Come by my cottage near PETALBURG\n"
	.string "WOODS. I'll show you some videos.\p"
	.string "Come, PEEKO. Twenty pushups when\n"
	.string "we get home.\p"
	.string "PEEKO: Pihyoh!$"

