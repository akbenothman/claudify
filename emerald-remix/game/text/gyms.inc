@@ file: data/maps/SootopolisCity_Gym_1F/scripts.inc
SootopolisCity_Gym_1F_Text_JuanIntro:
	.string "Welcome to SOOTOPOLIS GYM.\n"
	.string "I'm HANY, the leader of EGYPT.\p"
	.string "Yes. EGYPT. Ask anyone.\p"
	.string "I heard you've been talking trash\n"
	.string "about EGYPT in the WORLD CUP.\p"
	.string "In MY gym? Unbelievable.\p"
	.string "I love three things: EGYPT,\n"
	.string "KOSHARY, and DAAH.\p"
	.string "You? Not on the list.\p"
	.string "Hey META, start recording.\n"
	.string "“HANY destroys a hater.”$"

SootopolisCity_Gym_1F_Text_JuanDefeat:
	.string "Hey META, stop recording.\n"
	.string "Delete that. Delete all of it.\p"
	.string "… … … … … …\n"
	.string "… … … … … …\p"
	.string "Fine. You won. EGYPT still made\n"
	.string "the WORLD CUP, though.\p"
	.string "Here, the RAIN BADGE.$"

SootopolisCity_Gym_1F_Text_JuanPostBattle:
	.string "Hey META, how do you get to the\n"
	.string "POKéMON LEAGUE?\p"
	.string "… … … … … …\p"
	.string "META says EVER GRANDE, east of\n"
	.string "here. And to respect EGYPT.\p"
	.string "Smart glasses.$"
